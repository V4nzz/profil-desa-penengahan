# Environment Variables untuk Supabase
# Copy file ini ke .env dan isi dengan credentials dari Supabase dashboard

# Supabase Project URL (dari Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (dari Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
